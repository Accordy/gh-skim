# Ruby preset for gh skim.

# Resolved by Bundler from the Gemfile, which is reviewed.
**/Gemfile.lock

# Gems vendored into the repository. A verbatim copy of upstream.
**/vendor/bundle/**
**/vendor/cache/**

# Type signatures generated by Tapioca for gems and DSLs.
**/sorbet/rbi/gems/**
**/sorbet/rbi/dsl/**

# Note: db/schema.rb and structure.sql are deliberately NOT here. They are
# generated, but they show what a migration did to the database, and someone
# has to read that.
